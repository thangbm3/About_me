    <dialog id="demoDialog" class="demo-dialog" aria-labelledby="dialogTitle">
      <div class="dialog-header"><span id="dialogTitle" class="mono">UR10 / FULL EXPERIMENT / 20 SEC</span><button type="button" class="dialog-close" id="closeDemo" aria-label="Close video">✕</button></div>
      <video id="fullDemoVideo" controls playsinline preload="none" poster="./media/ur10-poster.webp" aria-label="Full UR10 collision-avoidance test recording"><source src="./media/ur10-full-demo.mp4" type="video/mp4" />Video playback is not supported.</video>
      <p class="dialog-note">Original experiment footage, compressed for web playback. Presented without claim of formal collision-safety guarantees.</p>
    </dialog>
  </body>
</html>
